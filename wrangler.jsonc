// Committed so `wrangler deploy` cannot auto-configure and rewrite the build scripts in CI.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ledger",
	"compatibility_date": "2026-07-12",
	// keeps the dashboard-set vars (DB, LEDGER_PEPPER) on config-based deploys
	"keep_vars": true,
	// pg (TCP sockets) and node:crypto need Node compatibility
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	// workout.* stays attached so hooks.server.ts can 301 old links across
	"routes": [
		{ "pattern": "ledger.dillonoleary.com", "custom_domain": true },
		{ "pattern": "workout.dillonoleary.com", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "7d60b374c6434905a51c6ed070b9d3f8"
		}
	],
	"build": {
		"command": "pnpm run build"
	}
}
